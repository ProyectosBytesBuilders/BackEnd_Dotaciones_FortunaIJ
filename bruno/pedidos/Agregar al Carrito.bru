meta {
  name: Agregar al Carrito
  type: http
  seq: 2
}

post {
  url: http://localhost:3000/api/cart/items
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
    "productId": "PEGA_AQUI_EL_ID_DEL_PRODUCTO",
    "quantity": 2
  }
}

settings {
  encodeUrl: true
  timeout: 0
}
